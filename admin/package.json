lib/sales-payment-breakdown.test.js\" \".pos-test-dist/lib/inventory-operation-launch.test.js\" \".pos-test-dist/lib/party-user-role-selection.test.js\" \".pos-test-dist/lib/party-identification.test.js\" \".pos-test-dist/lib/party-tax-profile.test.js\" \".pos-test-dist/lib/change-password.test.js\" \".pos-test-dist/lib/tenant-legal-identity.test.js\"",
