    "test:approval-permissions": "tsc -p tsconfig.pos-tests.json && node --test \".pos-test-dist/services/pos/pos-approval-client.test.js\"",
    "test:line-editor": "tsc -p tsconfig.pos-tests.json && node --test \".pos-test-dist/app/(pos)/pos/pos-line-editor-calculation.test.js\"",
    "test:pwa": "node scripts/verify-pwa-launch-assets.mjs",
    "build": "next build",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "lint": "eslint .",
    "test:e2e": "playwright test"
